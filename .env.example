# Variables de entorno de ejemplo (sin secretos).
# Copia este archivo como .env y rellena los valores. El archivo .env está en .gitignore.
# Instrucciones completas en SUPABASE_SETUP.md.

# URL del proyecto de Supabase, p. ej. https://abcdefghijklmnop.supabase.co
NUXT_PUBLIC_SUPABASE_URL=

# Clave PUBLICABLE del proyecto (empieza por sb_publishable_).
# Llega al navegador por diseño; la protección de los datos depende de las políticas RLS.
NUXT_PUBLIC_SUPABASE_KEY=

# No añadas aquí la clave secreta (sb_secret_...) ni la service_role:
# la aplicación no las necesita y saltan todas las políticas RLS.
