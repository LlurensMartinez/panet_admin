# Variables de entorno de ejemplo (sin secretos).
# Copia este archivo como .env y rellena los valores. El archivo .env está en .gitignore.
# Instrucciones completas en SUPABASE_SETUP.md.

# URL del proyecto de Supabase, p. ej. https://abcdefghijklmnop.supabase.co
NUXT_PUBLIC_SUPABASE_URL=

# Clave PUBLICABLE del proyecto (empieza por sb_publishable_).
# Llega al navegador por diseño; la protección de los datos depende de las políticas RLS.
NUXT_PUBLIC_SUPABASE_KEY=

# ---- Solo servidor (gestión de usuarios, SUPABASE_SETUP.md sección 15) ----
# Nunca con el prefijo NUXT_PUBLIC_: no deben llegar al navegador.

# Clave SECRETA del proyecto (empieza por sb_secret_). Salta todas las políticas
# RLS: solo la usan las rutas del servidor que invitan y quitan el acceso.
# Si se deja vacía, la gestión de usuarios no está disponible.
NUXT_SUPABASE_SECRET_KEY=

# UUID (Authentication → Users) de la cuenta de administración principal,
# la única que puede gestionar usuarios.
NUXT_PANET_ADMIN_USER_ID=
